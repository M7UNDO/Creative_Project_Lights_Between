  m_Script: {fileID: 11500000, guid: 0ce59cacb38a79c4bafa296c62696bed, type: 3}
  m_Name: Dialogue_AgressiveEncounter
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  formattedLines:
  - speakerName: ???
    textColor: {r: 0.53333336, g: 0.53333336, b: 0.53333336, a: 1}
    text: Miguel.
  - speakerName: Miguel
    textColor: {r: 1, g: 1, b: 1, a: 1}
    text: ...How do you know my name?
  - speakerName: ???
    textColor: {r: 0.53333336, g: 0.53333336, b: 0.53333336, a: 1}
    text: You don't have to be afraid.
  - speakerName: Miguel
    textColor: {r: 1, g: 1, b: 1, a: 1}
    text: Stay away from the door!
  - speakerName: ???
    textColor: {r: 0.53333336, g: 0.53333336, b: 0.53333336, a: 1}
    text: I won't make it hurt
  - speakerName: Miguel
    textColor: {r: 1, g: 1, b: 1, a: 1}
    text: ...What?
  - speakerName: ???
    textColor: {r: 0.53333336, g: 0.53333336, b: 0.53333336, a: 1}
    text: WHEN I KILL YOU!
  - speakerName: Miguel
    textColor: {r: 1, g: 1, b: 1, a: 1}
    text: I need to call for help, right now! I have to reach my family or the police,
      anyone who can get me out of here.
  - speakerName: Miguel
    textColor: {r: 1, g: 1, b: 1, a: 1}
    text: My phone should still be upstairs in my room. I need to get to it now.
  lines: []
  onDialogueCompletedEvent: {fileID: 11400000, guid: fbe17926ad7522948b527abeeeb466a9, type: 2}
