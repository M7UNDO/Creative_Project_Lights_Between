  formattedLines:
  - speakerName: ???
    textColor: {r: 0.53333336, g: 0.53333336, b: 0.53333336, a: 1}
    text: Please! Please, let me in.
  - speakerName: Miguel
    textColor: {r: 1, g: 1, b: 1, a: 1}
    text: Who is this?
  - speakerName: ???
    textColor: {r: 0.53333336, g: 0.53333336, b: 0.53333336, a: 1}
    text: "Please! Open the door, there\u2019s something out here in the woods!"
  - speakerName: Miguel
    textColor: {r: 1, g: 1, b: 1, a: 1}
    text: The woods...? Look, I can't. A lot of strange things have been happening
      tonight.
  - speakerName: ???
    textColor: {r: 0.53333336, g: 0.53333336, b: 0.53333336, a: 1}
    text: Please! I have nowhere else to go!
  - speakerName: Miguel
    textColor: {r: 1, g: 1, b: 1, a: 1}
    text: I'm sorry. I'm not opening this door.
