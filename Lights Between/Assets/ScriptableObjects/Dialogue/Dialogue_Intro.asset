  m_Script: {fileID: 11500000, guid: 0ce59cacb38a79c4bafa296c62696bed, type: 3}
  m_Name: Dialogue_Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  formattedLines: []
  lines:
  - Six hours on that bus. My back's killing me.
  - Can't complain, though. Guess that's the price you pay for living out here. At
    least it's peaceful
  - Finally, a break from lectures  and deadlines. Summer couldn't have come soon
    enough.
  - Haven't heard from anyone all week. You'd think they'd at least call, knowing
    I was coming home today
  - Huh, that's strange. The door's creaked open. Maybe they were expecting me.
  onDialogueCompletedEvent: {fileID: 0}
