  m_Script: {fileID: 11500000, guid: b769da97cc9c62c4c9115b0b03ad86d2, type: 3}
  m_Name: Dad's Journal 1
  m_EditorClassIdentifier: Assembly-CSharp::NoteData
  pages:
  - "(Torn) Journal Entry 1:\n\nIt was supposed to be an apology. I\u2019ve been
    driving back and forth on those dark highway roads every night, coming home long
    after my dear boys are asleep. My business is drowning. If I lose it, we lose
    all of this: the house, the peaceful countryside, the life I nearly broke my
    back to give them. I bought the doll from a small stall on the side of the road.
    An innocent gift for Sammy to make up for all the late nights. I had no idea
    what I was bringing across our threshold. Anne has been trying to hold us together,
    but I hear her crying in the hallway when she thinks I\u2019m asleep. She sits
    up until dawn reading the Bible, refusing to touch the sleeping pills I brought
    home. So I started taking them instead. Copious amounts just to shut my brain
    off for an hour or two, washing them down with a drink. I even picked up smoking
    again after six years clean. My hands won't stop shaking."
  triggersObjective: 0
