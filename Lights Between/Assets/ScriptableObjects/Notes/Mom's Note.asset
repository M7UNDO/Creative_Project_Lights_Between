  m_Script: {fileID: 11500000, guid: b769da97cc9c62c4c9115b0b03ad86d2, type: 3}
  m_Name: Mom's Note
  m_EditorClassIdentifier: Assembly-CSharp::NoteData
  noteContent: "Dear Miguel,\r\n\r\nI left some supper for you in the fridge. Just
    heat it up when you\u2019re ready.\r\n\r\nSomething came up this afternoon, so
    your father and I had to go to your aunt\u2019s for the night. We took Samuel
    with us. We didn\u2019t want to leave him here on his own, and your father thought
    it would be better if we all went together.\r\n\r\nWe should be back tomorrow.
    I\u2019m sorry we won\u2019t be here to see you when you got home. I know you
    were looking forward to coming back.\r\n\r\nThere\u2019s plenty of food in the
    fridge, so you don\u2019t need to worry about making anything tonight. Have your
    supper and get some rest. I\u2019m sure the trip must have been a long one.\r\n\r\nGive
    me a ring when you get this, just so I know you got home safely.\r\n\r\nSee you
    tomorrow.\r\n\r\nLove Mom\r\n"
