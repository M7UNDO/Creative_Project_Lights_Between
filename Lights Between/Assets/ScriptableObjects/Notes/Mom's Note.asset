  m_Script: {fileID: 11500000, guid: b769da97cc9c62c4c9115b0b03ad86d2, type: 3}
  m_Name: Mom's Note
  m_EditorClassIdentifier: Assembly-CSharp::NoteData
  noteContent: "Hey Miguel,\r\n\r\nWe got some sad news this afternoon about someone
    close to the family, so your father and I had to go to your aunt\u2019s for the
    night. We took Samuel with us. We thought it was best that we all went together,
    and we should be back by tomorrow.\r\n\r\nI\u2019m sorry we won\u2019t be there
    when you get home. I know you\u2019ve been looking forward to coming back, so
    just relax and enjoy some quiet time tonight.\r\n\r\nEverything is taken care
    of here, so don\u2019t worry about anything. Have your supper and get some rest.
    We\u2019ll see you tomorrow.\n\r\nLove Mom\r\n"
